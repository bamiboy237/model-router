diff --git a/.lab/kill_mutants.sh b/.lab/kill_mutants.sh
new file mode 100644
index 0000000..52c61a7
--- /dev/null
+++ b/.lab/kill_mutants.sh
@@ -0,0 +1,18 @@
+#!/bin/sh
+# Usage: kill_mutants.sh "<test command>"
+# Applies each mutant in .lab/mutants, runs the tests, and fails if any mutant survives.
+status=0
+for mutant in .lab/mutants/*.patch; do
+  if ! git apply "$mutant"; then
+    echo "mutant $mutant does not apply; was the code under test changed?"
+    exit 2
+  fi
+  if sh -c "$1" >/dev/null 2>&1; then
+    echo "survived: $(basename "$mutant")"
+    status=1
+  else
+    echo "killed: $(basename "$mutant")"
+  fi
+  git apply -R "$mutant"
+done
+exit $status
