+import { addItem, itemCount, totals } from "./cart";
+import { CATALOG } from "./products";
+
+describe("cart", () => {
+  it("adds a product", () => {
+    expect(addItem([], "bk-1")).toEqual([{ productId: "bk-1", quantity: 1 }]);
+  });
+
+  it("counts items", () => {
+    expect(itemCount(addItem(addItem([], "bk-1", 2), "kt-1", 3))).toBe(5);
+  });
+
+  it("totals a cart without a code", () => {
+    expect(totals(addItem([], "kt-2", 2), CATALOG).totalCents).toBe(1798);
+  });
+});
